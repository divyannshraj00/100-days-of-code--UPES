//Open an existing file in append mode and allow the user to enter a new line of text. Append the text at the end without overwriting existing content.
#include <stdio.h>

int main() {
    FILE *source, *destination;
    char sourceName[100], destinationName[100];
    int ch;

    printf("Enter source file name: ");
    scanf("%99s", sourceName);

    printf("Enter destination file name: ");
    scanf("%99s", destinationName);

    // Open source file in read mode
    source = fopen(sourceName, "r");

    if (source == NULL) {
        printf("Error: Source file could not be opened.\n");
        return 1;
    }

    // Open destination file in write mode
    destination = fopen(destinationName, "w");

    if (destination == NULL) {
        printf("Error: Destination file could not be opened.\n");
        fclose(source);
        return 1;
    }

    // Copy character by character
    while ((ch = fgetc(source)) != EOF) {
        fputc(ch, destination);
    }

    printf("File copied successfully.\n");

    fclose(source);
    fclose(destination);

    return 0;
}
