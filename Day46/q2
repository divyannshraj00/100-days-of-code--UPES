/Find the first repeating lowercase alphabet in a string.
#include <stdio.h>

int main()
{
    char str[100];
    int i, freq[26] = {0}, found = 0;

    printf("Enter a string: ");
    scanf("%99s", str);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] >= 'a' && str[i] <= 'z')
        {
            freq[str[i] - 'a']++;
        }
    }

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] >= 'a' && str[i] <= 'z' &&
           freq[str[i] - 'a'] > 1)
        {
            printf("First repeating alphabet = %c", str[i]);
            found = 1;
            break;
        }
    }

    if(found == 0)
    {
        printf("No repeating lowercase alphabet");
    }

    return 0;
}
