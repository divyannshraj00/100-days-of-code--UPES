/Change the date format from dd/04/yyyy to dd-Apr-yyyy.
#include <stdio.h>

int main()
{
    int dd, mm, yyyy;

    char *month[] = {"", "Jan", "Feb", "Mar", "Apr",
                     "May", "Jun", "Jul", "Aug",
                     "Sep", "Oct", "Nov", "Dec"};

    printf("Enter date (dd/mm/yyyy): ");
    scanf("%d/%d/%d", &dd, &mm, &yyyy);

    if(mm >= 1 && mm <= 12 && dd >= 1 && dd <= 31)
    {
        printf("Formatted Date = %02d-%s-%04d",
               dd, month[mm], yyyy);
    }
    else
    {
        printf("Invalid Date");
    }

    return 0;
}
