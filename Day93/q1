//Q143: Find and print the student with the highest marks.
#include <stdio.h>

struct Student {
    char name[50];
    int roll;
    int marks;
};

int main() {
    struct Student s[3];
    int i, max = 0;

    // Input details of 3 students
    for (i = 0; i < 3; i++) {
        scanf("%49s %d %d",
              s[i].name, &s[i].roll, &s[i].marks);
    }

    // Find student with highest marks
    for (i = 1; i < 3; i++) {
        if (s[i].marks > s[max].marks) {
            max = i;
        }
    }

    // Display topper
    printf("Topper: %s (Marks: %d)\n",
           s[max].name, s[max].marks);

    return 0;
}
