/Reverse each word in a sentence without changing the word order.
#include <stdio.h>

int main()
{
    char str[100], temp;
    int i, j, start = 0;

    printf("Enter a sentence: ");
    fgets(str, sizeof(str), stdin);

    for(i = 0; ; i++)
    {
        if(str[i] == ' ' || str[i] == '\n' ||
           str[i] == '\0')
        {
            int end = i - 1;

            for(j = start; j < end; j++, end--)
            {
                temp = str[j];
                str[j] = str[end];
                str[end] = temp;
            }

            start = i + 1;
        }

        if(str[i] == '\0' || str[i] == '\n')
        {
            break;
        }
    }

    printf("Modified sentence: %s", str);

    return 0;
}
