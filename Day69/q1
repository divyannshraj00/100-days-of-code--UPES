//Write a program to take an integer array as input. Only one element will be repeated. Print the repeated element. Try to find the result in one single iteration.

#include <stdio.h>

int main()
{
    int n, arr[1000], freq[1001] = {0};
    int repeated = -1;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    for (int i = 0; i < n; i++)
    {
        if (freq[arr[i]] == 1)
        {
            repeated = arr[i];
            break;
        }

        freq[arr[i]] = 1;
    }

    printf("%d", repeated);

    return 0;
}
